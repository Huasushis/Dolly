{
  "name": "dolly",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first agent runtime with isolated, capability-based extensions",
  "type": "module",
  "main": "./dist/src/entry.js",
  "types": "./dist/src/entry.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/entry.d.ts",
      "import": "./dist/src/entry.js"
    },
    "./sdk": {
      "types": "./dist/src/sdk/index.d.ts",
      "import": "./dist/src/sdk/index.js"
    }
  },
  "bin": {
    "dolly": "./bin/dolly.js"
  },
  "files": [
    "bin/",
    "dist/",
    "LICENSE",
    "!dist/daemon",
    "!dist/extensions",
    "!dist/src/config.*",
    "!dist/src/core/block-manager.*",
    "!dist/src/core/ipc.*",
    "!dist/src/core/legacy-in-process-extension.*",
    "!dist/src/core/media.*",
    "!dist/src/core/orchestrator.*",
    "!dist/src/core/page.*",
    "!dist/src/core/scheduler.*",
    "!dist/src/core/types.*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node bin/dolly.js run",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:conformance": "vitest run --config vitest.config.ts tests/conformance",
    "test:legacy": "vitest run --config vitest.legacy.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.31.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ali-oss": "^6.23.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^4.0.0",
    "dotenv": "^16.4.0",
    "mcp-server-commands": "^0.8.2",
    "openai": "^4.70.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "tavily-mcp": "^0.2.19",
    "ws": "^8.20.1",
    "zod": "^3.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
