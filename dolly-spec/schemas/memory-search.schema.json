{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/schemas/memory-search.schema.json",
  "title": "org.dolly.memory.search arguments",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_parts", "query_basis_block_ids", "filters", "limit", "token_budget", "index_revision"],
  "properties": {
    "query_parts": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "text", "format"],
        "properties": {
          "kind": { "const": "text" },
          "text": { "type": "string", "minLength": 1, "maxLength": 262144 },
          "format": { "enum": ["plain", "markdown"] }
        }
      }
    },
    "query_basis_block_ids": {
      "$comment": "Earlier committed Blocks whose content was used to construct the query. The Runtime additionally excludes the Action-containing Block and every source Block in the frozen Activation input.",
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/UuidV7" }
    },
    "filters": {
      "type": "object", "additionalProperties": false,
      "required": ["page_ids", "time", "record_types", "statuses"],
      "properties": {
        "page_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/StableId" } },
        "time": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["from", "until"],
              "properties": {
                "from": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
                "until": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] }
              }
            }
          ]
        },
        "record_types": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "enum": ["evidence", "event", "fact", "preference", "decision", "procedure_candidate"] } },
        "statuses": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "enum": ["current", "historical", "candidate", "disputed", "retracted"] } }
      }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "token_budget": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "index_revision": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Revision" },
        { "type": "null" }
      ]
    }
  }
}
