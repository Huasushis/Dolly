{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/schemas/backup-manifest.schema.json",
  "title": "Verified Dolly instance backup manifest",
  "$defs": {
    "InstanceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daemon_installation_id", "instance_id", "platform"],
      "properties": {
        "daemon_installation_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
        "instance_id": { "$ref": "common.schema.json#/$defs/StableId" },
        "platform": { "enum": ["linux-x86_64", "windows-x86_64"] }
      }
    },
    "ExternalStateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "kind", "clone_policy"],
      "properties": {
        "reference_id": { "$ref": "common.schema.json#/$defs/StableId" },
        "kind": {
          "enum": ["remote_database", "account_session", "provider_state", "external_journal"]
        },
        "clone_policy": {
          "enum": ["disabled_until_rebound", "private_copy_only", "fenced_restore_supported"]
        }
      }
    },
    "ModuleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension_alias", "extension_id", "package_digest", "source_extension_generation",
        "module_id", "module_type", "storage_scope_id",
        "state_schema_version", "snapshot_id", "snapshot_payload_digest",
        "last_writer_generation", "external_state_refs"
      ],
      "properties": {
        "extension_alias": { "$ref": "common.schema.json#/$defs/StableId" },
        "extension_id": { "$ref": "common.schema.json#/$defs/ExtensionId" },
        "package_digest": { "$ref": "common.schema.json#/$defs/Sha256" },
        "source_extension_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "module_id": { "$ref": "common.schema.json#/$defs/StableId" },
        "module_type": { "$ref": "common.schema.json#/$defs/StableId" },
        "storage_scope_id": { "$ref": "common.schema.json#/$defs/ModuleStorageScopeId" },
        "state_schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "snapshot_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
        "snapshot_payload_digest": { "$ref": "common.schema.json#/$defs/Sha256" },
        "last_writer_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "external_state_refs": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/ExternalStateRef" }
        }
      }
    },
    "ObjectEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "media_type", "byte_length", "digest"],
      "properties": {
        "logical_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "media_type": { "$ref": "common.schema.json#/$defs/MimeType" },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "digest": { "$ref": "common.schema.json#/$defs/Sha256" }
      }
    },
    "StorageSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id", "schema_version"],
      "properties": {
        "store_id": { "$ref": "common.schema.json#/$defs/StableId" },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "backup_id", "format_version", "dolly_core_version", "source",
    "config_revision", "config_digest", "graph_revision", "graph_digest",
    "storage_schemas", "consistency_class", "cut_metadata_digest", "modules",
    "objects", "excluded_components", "compression", "encryption", "creation_tool",
    "created_at", "verification_result"
  ],
  "properties": {
    "schema": { "const": "dolly.backup-manifest/v1" },
    "backup_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
    "format_version": { "const": 1 },
    "dolly_core_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "source": { "$ref": "#/$defs/InstanceIdentity" },
    "config_revision": { "$ref": "common.schema.json#/$defs/Revision" },
    "config_digest": { "$ref": "common.schema.json#/$defs/Sha256" },
    "graph_revision": { "$ref": "common.schema.json#/$defs/Revision" },
    "graph_digest": { "$ref": "common.schema.json#/$defs/Sha256" },
    "storage_schemas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/StorageSchema" }
    },
    "consistency_class": { "enum": ["quiesced", "online"] },
    "cut_metadata_digest": { "$ref": "common.schema.json#/$defs/Sha256" },
    "modules": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/ModuleEntry" }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/ObjectEntry" }
    },
    "excluded_components": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "rebuild_recipe"],
        "properties": {
          "component": { "$ref": "common.schema.json#/$defs/StableId" },
          "rebuild_recipe": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    },
    "compression": { "enum": ["none", "zstd"] },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_reference"],
      "properties": {
        "algorithm": { "enum": ["none", "aes-256-gcm"] },
        "key_reference": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/SecretRef" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "algorithm": { "const": "none" } }, "required": ["algorithm"] },
          "then": { "properties": { "key_reference": { "type": "null" } } },
          "else": { "properties": { "key_reference": { "$ref": "common.schema.json#/$defs/SecretRef" } } }
        }
      ]
    },
    "creation_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/StableId" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "verification_result": { "const": "pass" }
  }
}
