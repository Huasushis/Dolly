{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/schemas/ingress-result.schema.json",
  "title": "Committed ingress result",
  "type": "object",
  "additionalProperties": false,
  "required": ["ingress_id", "block_id", "graph_revision", "deliveries"],
  "properties": {
    "ingress_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
    "block_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
    "graph_revision": { "$ref": "common.schema.json#/$defs/Revision" },
    "deliveries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_id", "page_seq", "commit_seq"],
        "properties": {
          "page_id": { "$ref": "common.schema.json#/$defs/StableId" },
          "page_seq": { "$ref": "common.schema.json#/$defs/Seq" },
          "commit_seq": { "$ref": "common.schema.json#/$defs/Seq" }
        }
      }
    }
  }
}
