{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/schemas/memory-search-result.schema.json",
  "title": "Successful org.dolly.memory.search result payload",
  "x-dolly-action-result-validator": {
    "id": "org.dolly.validator.memory-search-result",
    "revision": 1
  },
  "$defs": {
    "NullableScore": {
      "oneOf": [
        { "type": "number" },
        { "type": "null" }
      ]
    },
    "SearchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_id", "record_revision", "source_block_ids", "record_type", "status",
        "validation_state", "supersedes_memory_id", "conflict_set_id",
        "evidence_span", "component_scores", "final_score",
        "retrieval_reason", "derived_summary", "derived_from_memory_ids"
      ],
      "properties": {
        "memory_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
        "record_revision": { "$ref": "common.schema.json#/$defs/Revision" },
        "source_block_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/UuidV7" }
        },
        "record_type": { "$ref": "memory-record.schema.json#/properties/record_type" },
        "status": { "$ref": "memory-record.schema.json#/$defs/RecordStatus" },
        "validation_state": { "$ref": "memory-record.schema.json#/$defs/ValidationState" },
        "supersedes_memory_id": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/UuidV7" },
            { "type": "null" }
          ]
        },
        "conflict_set_id": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/UuidV7" },
            { "type": "null" }
          ]
        },
        "evidence_span": {
          "type": "object",
          "additionalProperties": false,
          "$comment": "The Extension additionally enforces the configured UTF-8 byte and token budgets.",
          "required": ["text", "truncated"],
          "properties": {
            "text": { "type": "string", "maxLength": 32768 },
            "truncated": { "type": "boolean" }
          }
        },
        "component_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lexical", "dense", "rerank"],
          "properties": {
            "lexical": { "$ref": "#/$defs/NullableScore" },
            "dense": { "$ref": "#/$defs/NullableScore" },
            "rerank": { "$ref": "#/$defs/NullableScore" }
          }
        },
        "final_score": { "type": "number" },
        "retrieval_reason": { "enum": ["lexical", "dense", "hybrid", "reranked"] },
        "derived_summary": { "type": "boolean" },
        "derived_from_memory_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/UuidV7" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "derived_summary": { "const": true } }, "required": ["derived_summary"] },
          "then": { "properties": { "derived_from_memory_ids": { "type": "array", "minItems": 1 } } },
          "else": { "properties": { "derived_from_memory_ids": { "type": "array", "maxItems": 0 } } }
        },
        {
          "$comment": "A disputed search result preserves a visible supersession or conflict-set link.",
          "if": { "properties": { "status": { "const": "disputed" } }, "required": ["status"] },
          "then": {
            "anyOf": [
              {
                "properties": { "supersedes_memory_id": { "$ref": "common.schema.json#/$defs/UuidV7" } },
                "required": ["supersedes_memory_id"]
              },
              {
                "properties": { "conflict_set_id": { "$ref": "common.schema.json#/$defs/UuidV7" } },
                "required": ["conflict_set_id"]
              }
            ]
          }
        },
        {
          "$comment": "Rejected evidence remains auditable but cannot be returned as current.",
          "if": { "properties": { "validation_state": { "const": "rejected" } }, "required": ["validation_state"] },
          "then": { "properties": { "status": { "not": { "const": "current" } } } }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "retrieval_id", "trust_class", "query_digest",
    "query_basis_digest", "query_basis_count", "index_revision", "results",
    "abstention_reason", "truncated"
  ],
  "properties": {
    "schema": { "const": "dolly.memory-search-result/v1" },
    "retrieval_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
    "trust_class": { "const": "untrusted_user_derived" },
    "query_digest": {
      "$comment": "SHA-256 of the JCS object containing validated arguments, sorted effective query-basis IDs, and the selected index revision.",
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "query_basis_digest": { "$ref": "common.schema.json#/$defs/Sha256" },
    "query_basis_count": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "index_revision": { "$ref": "common.schema.json#/$defs/Revision" },
    "results": {
      "type": "array",
      "maxItems": 100,
      "$comment": "The bound semantic validator rejects duplicate (memory_id, record_revision) identities even when the remaining fields differ.",
      "items": { "$ref": "#/$defs/SearchResult" }
    },
    "abstention_reason": {
      "oneOf": [
        { "enum": ["insufficient_evidence", "no_match", "no_authorized_evidence", "filtered", "budget_exhausted"] },
        { "type": "null" }
      ]
    },
    "truncated": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "results": { "type": "array", "maxItems": 0 } }, "required": ["results"] },
      "then": {
        "properties": {
          "abstention_reason": {
            "enum": ["insufficient_evidence", "no_match", "no_authorized_evidence", "filtered", "budget_exhausted"]
          }
        }
      },
      "else": { "properties": { "abstention_reason": { "type": "null" } } }
    }
  ]
}
