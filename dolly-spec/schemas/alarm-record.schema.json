{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/schemas/alarm-record.schema.json",
  "title": "Dolly Alarm record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alarm_id", "revision", "title", "schedule", "delivery",
    "misfire_policy", "dst_gap_policy", "dst_fold_policy", "enabled",
    "created_at", "next_occurrence", "tzdb_revision"
  ],
  "properties": {
    "alarm_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
    "revision": { "$ref": "common.schema.json#/$defs/Revision" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "schedule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "at"],
          "properties": {
            "kind": { "const": "once" },
            "at": { "$ref": "common.schema.json#/$defs/Timestamp" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "every_seconds", "anchor"],
          "properties": {
            "kind": { "const": "interval" },
            "every_seconds": { "type": "integer", "minimum": 1, "maximum": 315576000 },
            "anchor": { "$ref": "common.schema.json#/$defs/Timestamp" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expression", "timezone"],
          "properties": {
            "kind": { "const": "cron_v1" },
            "expression": { "type": "string", "minLength": 9, "maxLength": 128, "pattern": "^[0-9*/, -]+$" },
            "timezone": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z][A-Za-z0-9._+-]*(?:/[A-Za-z0-9._+-]+)*$" }
          }
        }
      ]
    },
    "delivery": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "once" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "repeat_interval_seconds"],
          "properties": {
            "mode": { "const": "repeat_until_acknowledged" },
            "repeat_interval_seconds": { "type": "integer", "minimum": 1, "maximum": 315576000 }
          }
        }
      ]
    },
    "misfire_policy": { "enum": ["skip", "fire_once", "catch_up"] },
    "dst_gap_policy": { "enum": ["shift_by_gap", "skip"] },
    "dst_fold_policy": { "enum": ["earlier", "later", "both"] },
    "enabled": { "type": "boolean" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "next_occurrence": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Timestamp" },
        { "type": "null" }
      ]
    },
    "tzdb_revision": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._+-]+$" }
  }
}
