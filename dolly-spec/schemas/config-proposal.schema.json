{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/schemas/config-proposal.schema.json",
  "title": "ConfigProposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "base_revision", "principal", "reason", "patch", "expected_impact", "rollback_condition", "destructive_dispositions", "deadline"],
  "properties": {
    "operation_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
    "base_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "principal": { "$ref": "common.schema.json#/$defs/StableId" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "expected_impact": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "rollback_condition": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "patch": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path"],
        "properties": {
          "op": { "enum": ["add", "remove", "replace", "move", "copy", "test"] },
          "path": { "type": "string", "pattern": "^/", "maxLength": 2048 },
          "from": { "type": "string", "pattern": "^/", "maxLength": 2048 },
          "value": { "$ref": "common.schema.json#/$defs/JsonValue" }
        },
        "allOf": [
          {
            "if": { "properties": { "op": { "enum": ["move", "copy"] } }, "required": ["op"] },
            "then": {
              "required": ["from"],
              "not": { "required": ["value"] }
            }
          },
          {
            "if": { "properties": { "op": { "enum": ["add", "replace", "test"] } }, "required": ["op"] },
            "then": {
              "required": ["value"],
              "not": { "required": ["from"] }
            }
          },
          {
            "if": { "properties": { "op": { "const": "remove" } }, "required": ["op"] },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["from"] },
                  { "required": ["value"] }
                ]
              }
            }
          }
        ]
      }
    },
    "destructive_dispositions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_kind", "resource_id", "disposition", "first_seq", "last_seq", "estimated_bytes", "approval_id"],
        "properties": {
          "resource_kind": { "enum": ["page", "module", "subscription", "asset_root", "memory_root"] },
          "resource_id": { "$ref": "common.schema.json#/$defs/StableId" },
          "disposition": { "enum": ["archive", "transfer", "dead_letter", "audited_discard"] },
          "target_id": { "$ref": "common.schema.json#/$defs/StableId" },
          "first_seq": { "$ref": "common.schema.json#/$defs/Seq" },
          "last_seq": { "$ref": "common.schema.json#/$defs/Seq" },
          "estimated_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "approval_id": { "$ref": "common.schema.json#/$defs/UuidV7" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "disposition": { "const": "transfer" } },
              "required": ["disposition"]
            },
            "then": { "required": ["target_id"] },
            "else": { "not": { "required": ["target_id"] } }
          }
        ]
      }
    },
    "deadline": { "$ref": "common.schema.json#/$defs/Timestamp" }
  }
}
