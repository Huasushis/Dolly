{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/schemas/extension-rpc-registry.schema.json",
  "title": "Dolly Extension RPC v1 machine-readable method registry",
  "$defs": {
    "SchemaUri": {
      "type": "string",
      "format": "uri",
      "maxLength": 512,
      "pattern": "^https://dolly\\.example/spec/0\\.1/schemas/[a-z0-9-]+\\.schema\\.json(?:#/(?:\\$defs|properties)/[A-Za-z0-9._~-]+)?$"
    },
    "JsonPointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"
    },
    "SemanticDepthPolicy": {
      "description": "Protocol-wide semantic JSON nesting policy for every schema resource selected by a request, notification, or response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_json_nesting_depth", "root_depth", "rpc_envelope_counted",
        "declared_schema_roots"
      ],
      "properties": {
        "max_json_nesting_depth": { "const": 64 },
        "root_depth": { "const": 1 },
        "rpc_envelope_counted": { "const": false },
        "declared_schema_roots": {
          "description": "request_params names a request's params resource; notification_params names a notification's params resource; success_result names a successful response's result resource; error_data names the common Dolly error data resource.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "request_params", "notification_params", "success_result",
              "error_data"
            ]
          }
        }
      }
    },
    "DeadlineBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pointer"],
      "properties": {
        "kind": { "enum": ["params_pointer", "manifest_pointer", "none"] },
        "pointer": {
          "oneOf": [
            { "$ref": "#/$defs/JsonPointer" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "none" } }, "required": ["kind"] },
          "then": { "properties": { "pointer": { "type": "null" } } },
          "else": { "properties": { "pointer": { "$ref": "#/$defs/JsonPointer" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "manifest_pointer" } }, "required": ["kind"] },
          "then": { "properties": { "pointer": { "const": "/manifest/deadline" } } }
        }
      ]
    },
    "OperationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "pointers"],
      "properties": {
        "scope": {
          "enum": [
            "connection_generation", "extension_process", "module", "configuration_transaction",
            "activation", "authenticated_module", "asset_import", "model_request", "tool_call", "ingress"
          ]
        },
        "pointers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/JsonPointer" }
        }
      }
    },
    "Reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "method"],
      "properties": {
        "kind": { "enum": ["read_retry", "process_state", "method", "frozen_activation"] },
        "method": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 160 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "method" } }, "required": ["kind"] },
          "then": { "properties": { "method": { "type": "string", "minLength": 1, "maxLength": 160 } } },
          "else": { "properties": { "method": { "type": "null" } } }
        }
      ]
    },
    "RequestContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method", "caller", "params_schema", "result_schema", "deadline",
        "operation_identity", "reconciliation", "unknown_policy", "state_changing"
      ],
      "properties": {
        "method": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9]*(?:[._][a-z][a-z0-9_]*)+$" },
        "caller": { "enum": ["host", "extension"] },
        "params_schema": { "$ref": "#/$defs/SchemaUri" },
        "result_schema": { "$ref": "#/$defs/SchemaUri" },
        "deadline": { "$ref": "#/$defs/DeadlineBinding" },
        "operation_identity": { "$ref": "#/$defs/OperationIdentity" },
        "reconciliation": { "$ref": "#/$defs/Reconciliation" },
        "unknown_policy": {
          "enum": [
            "not_applicable", "read_retry", "same_identity_only", "no_auto_replay",
            "process_state_authoritative", "frozen_activation_contract"
          ]
        },
        "state_changing": { "type": "boolean" }
      }
    },
    "NotificationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "caller", "params_schema", "loss_policy"],
      "properties": {
        "method": { "type": "string", "minLength": 1, "maxLength": 160 },
        "caller": { "enum": ["host", "extension", "either"] },
        "params_schema": { "$ref": "#/$defs/SchemaUri" },
        "loss_policy": { "enum": ["best_effort", "advisory_reconcile", "untrusted_hint", "lossy_telemetry"] }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "protocol", "semantic_depth", "error_data_schema", "requests",
    "notifications"
  ],
  "properties": {
    "schema": { "const": "dolly.extension-rpc-registry/v1" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "const": 0 }
      }
    },
    "semantic_depth": { "$ref": "#/$defs/SemanticDepthPolicy" },
    "error_data_schema": { "$ref": "#/$defs/SchemaUri" },
    "requests": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": { "$ref": "#/$defs/RequestContract" }
    },
    "notifications": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/NotificationContract" }
    }
  }
}
