{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/schemas/levelupper-entry-envelope.schema.json",
  "title": "LevelUpper occurrence-specific portable entry envelope",
  "$defs": {
    "ForeignKey": {
      "type": "string", "minLength": 1, "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "semantic_validator", "foreign_entry_key", "foreign_block_key", "share_id",
    "share_revision", "direction_id", "share_epoch_id", "export_seq", "origin",
    "content_digest", "previous_entry_hash", "entry_hash"
  ],
  "properties": {
    "schema": {"const": "dolly.levelupper-entry-envelope/v1"},
    "semantic_validator": {"const": "org.dolly.validator.levelupper-entry@1"},
    "foreign_entry_key": {"$ref": "#/$defs/ForeignKey"},
    "foreign_block_key": {"$ref": "#/$defs/ForeignKey"},
    "share_id": {"$ref": "common.schema.json#/$defs/StableId"},
    "share_revision": {"$ref": "common.schema.json#/$defs/Revision"},
    "direction_id": {"$ref": "common.schema.json#/$defs/StableId"},
    "share_epoch_id": {"$ref": "common.schema.json#/$defs/UuidV7"},
    "export_seq": {"$ref": "common.schema.json#/$defs/Seq"},
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["origin_peer_id", "origin_direction_id", "origin_share_epoch_id", "origin_entry_key", "visited_peer_path", "hop_count", "hop_limit"],
      "properties": {
        "origin_peer_id": {"$ref": "common.schema.json#/$defs/Sha256"},
        "origin_direction_id": {"$ref": "common.schema.json#/$defs/StableId"},
        "origin_share_epoch_id": {"$ref": "common.schema.json#/$defs/UuidV7"},
        "origin_entry_key": {"$ref": "#/$defs/ForeignKey"},
        "visited_peer_path": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/Sha256"}},
        "hop_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "hop_limit": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "content_digest": {"$ref": "common.schema.json#/$defs/Sha256"},
    "previous_entry_hash": {
      "oneOf": [{"$ref": "common.schema.json#/$defs/Sha256"}, {"type": "null"}]
    },
    "entry_hash": {"$ref": "common.schema.json#/$defs/Sha256"}
  }
}
