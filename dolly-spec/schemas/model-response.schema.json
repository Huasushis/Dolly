{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/schemas/model-response.schema.json",
  "title": "Successful host.model.invoke result",
  "$defs": {
    "OutputPart": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/Part" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "enum": ["text", "json", "asset"] } }
        }
      ]
    },
    "UsageMeasure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "properties": {
        "value": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "provenance": { "enum": ["provider_reported", "tokenizer_estimated", "unknown"] }
      },
      "allOf": [
        {
          "if": { "properties": { "provenance": { "const": "unknown" } }, "required": ["provenance"] },
          "then": { "properties": { "value": { "type": "null" } } },
          "else": { "properties": { "value": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } } }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "profile", "provider_request_id", "output_parts", "tool_call_proposals", "finish_reason", "structured_output_mode", "usage", "cost", "retry_history"],
  "properties": {
    "request_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
    "profile": { "$ref": "model-request.schema.json#/$defs/ProfileRef" },
    "provider_request_id": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 512 },
        { "type": "null" }
      ]
    },
    "output_parts": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/OutputPart" } },
    "tool_call_proposals": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "provider_call_id", "tool_server_id", "tool_name", "tool_schema_digest", "arguments"],
        "properties": {
          "operation_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
          "provider_call_id": {
            "oneOf": [
              { "type": "string", "minLength": 1, "maxLength": 512 },
              { "type": "null" }
            ]
          },
          "tool_server_id": { "$ref": "common.schema.json#/$defs/StableId" },
          "tool_name": { "$ref": "common.schema.json#/$defs/StableId" },
          "tool_schema_digest": { "$ref": "common.schema.json#/$defs/Sha256" },
          "arguments": { "type": "object", "maxProperties": 256 }
        }
      }
    },
    "finish_reason": { "enum": ["stop", "length", "tool_calls", "content_filter", "cancelled", "provider_other"] },
    "structured_output_mode": { "enum": ["none", "provider_json_schema", "virtual_emit_tool", "strict_json_text"] },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "reasoning_tokens", "cached_tokens", "image_units", "audio_units", "tool_units"],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/UsageMeasure" },
        "output_tokens": { "$ref": "#/$defs/UsageMeasure" },
        "reasoning_tokens": { "$ref": "#/$defs/UsageMeasure" },
        "cached_tokens": { "$ref": "#/$defs/UsageMeasure" },
        "image_units": { "$ref": "#/$defs/UsageMeasure" },
        "audio_units": { "$ref": "#/$defs/UsageMeasure" },
        "tool_units": { "$ref": "#/$defs/UsageMeasure" }
      }
    },
    "cost": {
      "type": "object", "additionalProperties": false,
      "required": ["microunits", "currency", "pricing_revision", "provenance"],
      "properties": {
        "microunits": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "pricing_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provenance": { "enum": ["actual", "estimated", "unknown"] }
      },
      "allOf": [
        {
          "if": { "properties": { "provenance": { "const": "unknown" } }, "required": ["provenance"] },
          "then": { "properties": { "microunits": { "type": "null" } } },
          "else": { "properties": { "microunits": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } } }
        }
      ]
    },
    "retry_history": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["attempt", "provider_phase_outcome", "code"],
        "properties": {
          "attempt": { "$ref": "common.schema.json#/$defs/Seq" },
          "provider_phase_outcome": { "enum": ["not_sent", "no_response", "partial", "complete", "unknown"] },
          "code": { "type": ["string", "null"], "maxLength": 96 }
        }
      }
    }
  }
}
