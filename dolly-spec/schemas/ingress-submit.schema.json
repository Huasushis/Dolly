{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/schemas/ingress-submit.schema.json",
  "title": "host.ingress.submit params",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "module_id", "idempotency_key", "draft", "target_page_ids", "deadline"],
  "properties": {
    "operation_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
    "module_id": { "$ref": "common.schema.json#/$defs/StableId" },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[ -~]+$" },
    "draft": { "$ref": "block-draft.schema.json" },
    "target_page_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/StableId" }
    },
    "deadline": { "$ref": "common.schema.json#/$defs/Timestamp" }
  }
}
