{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/schemas/extension-notification-rpc.schema.json",
  "title": "Consolidated Extension RPC notification parameter contracts",
  "$comment": "This catalog container is not a value schema. Callers MUST select one exact $defs fragment.",
  "not": {},
  "$defs": {
    "CancelRequestParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "enum": ["operator_request", "deadline", "shutdown", "revocation", "superseded"] }
      }
    },
    "ActivationDispositionParams": {
      "$ref": "activation-status.schema.json"
    },
    "DescriptorChangedParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "descriptor_revision", "descriptor_digest", "descriptor", "reason", "observed_at"],
      "properties": {
        "module_id": { "$ref": "common.schema.json#/$defs/StableId" },
        "descriptor_revision": { "$ref": "common.schema.json#/$defs/Revision" },
        "descriptor_digest": { "$ref": "common.schema.json#/$defs/Sha256" },
        "descriptor": { "$ref": "module-descriptor.schema.json" },
        "reason": { "enum": ["configuration", "capability", "state", "package", "operator_request"] },
        "observed_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "ExtensionProgressParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "module_id", "target_method", "phase", "completed", "total", "message", "observed_at"],
      "properties": {
        "operation_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
        "module_id": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/StableId" },
            { "type": "null" }
          ]
        },
        "target_method": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z$][A-Za-z0-9$_.-]*$" },
        "phase": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
        "completed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "total": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "message": { "type": "string", "maxLength": 1024 },
        "observed_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "LogEmitParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "module_id", "level", "message", "fields", "observed_at"],
      "properties": {
        "event_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
        "module_id": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/StableId" },
            { "type": "null" }
          ]
        },
        "level": { "enum": ["trace", "debug", "info", "warn", "error"] },
        "message": { "type": "string", "maxLength": 4096 },
        "fields": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/JsonValue" }
        },
        "observed_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "MetricsRecordParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "observed_at", "samples"],
      "properties": {
        "module_id": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/StableId" },
            { "type": "null" }
          ]
        },
        "observed_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "value", "unit", "labels"],
            "properties": {
              "name": { "$ref": "common.schema.json#/$defs/QualifiedName" },
              "kind": { "enum": ["counter", "gauge", "histogram_sample"] },
              "value": { "type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991 },
              "unit": {
                "oneOf": [
                  { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9%/_-]+$" },
                  { "type": "null" }
                ]
              },
              "labels": {
                "type": "object",
                "maxProperties": 16,
                "propertyNames": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
                "additionalProperties": { "type": "string", "maxLength": 128 }
              }
            }
          }
        }
      }
    }
  }
}
