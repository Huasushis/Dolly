{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/schemas/channel-send.schema.json",
  "title": "org.dolly.channel.send arguments",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "parts", "reply_to_external_message_id"],
  "properties": {
    "session_id": { "$ref": "common.schema.json#/$defs/StableId" },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "allOf": [
          { "$ref": "common.schema.json#/$defs/Part" },
          {
            "properties": {
              "kind": { "enum": ["text", "asset"] }
            }
          }
        ]
      }
    },
    "reply_to_external_message_id": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 512 },
        { "type": "null" }
      ]
    }
  }
}
