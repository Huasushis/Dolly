{
  "schema": "dolly.test-vector/v1",
  "test_id": "TST-TOOL-007",
  "kind": "config",
  "covers": ["REQ-TOOL-001", "REQ-TOOL-007"],
  "initial": {
    "old_config_revision": 10,
    "new_config_revision": 11,
    "old_tool_server_generation": 7,
    "new_tool_server_generation": 8,
    "old_revision_nonterminal_activations": 1,
    "old_generation_state": "Ready"
  },
  "stimulus": {
    "events": [
      "commit_new_registry_revision",
      "old_revision_activation_invokes_frozen_tool",
      "old_revision_activation_becomes_terminal"
    ]
  },
  "expected": {
    "outcome": "old_generation_ready_until_last_call_capable_activation_finishes",
    "assertions": [
      {"path": "/old_call/resolved_config_revision", "op": "equals", "value": 10},
      {"path": "/old_call/tool_server_generation", "op": "equals", "value": 7},
      {"path": "/new_revision_selected_old_generation_count", "op": "equals", "value": 0},
      {"path": "/old_generation/state_during_old_activation", "op": "equals", "value": "Ready"},
      {"path": "/old_generation/state_after_last_old_activation", "op": "equals", "value": "Draining"}
    ],
    "emitted": [
      {
        "event": "ToolServerGenerationDraining",
        "tool_server_generation": 7
      }
    ],
    "crash_label": null
  }
}
