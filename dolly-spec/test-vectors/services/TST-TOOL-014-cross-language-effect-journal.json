{
  "schema": "dolly.test-vector/v1",
  "test_id": "TST-TOOL-014",
  "kind": "protocol",
  "covers": [
    "REQ-TOOL-014",
    "INV-TOOL-014"
  ],
  "initial": {
    "contract": {
      "schema": "dolly.effect-journal-bridge/v1",
      "source": {
        "dialect": "typescript",
        "intent_schema": "dolly.effect-intent/2",
        "run_schema": "dolly.effect-run/1"
      },
      "target": {
        "dialect": "rust",
        "claim_schema": "dolly.claim/v2",
        "journal_schema": "dolly.external-effect-journal/v2"
      },
      "identity_mapping": {
        "source_fields": [
          "moduleJobId",
          "runId",
          "attempt",
          "claimToken",
          "moduleGenerationId"
        ],
        "target_fields": [
          "instance_id",
          "module_id",
          "operation_id",
          "operation_digest",
          "claim_token"
        ],
        "field_rules": [
          {
            "source": "moduleJobId",
            "target": "module_id",
            "rule": "exact-utf8-identifier"
          },
          {
            "source": "idempotencyKey",
            "target": "operation_id",
            "rule": "exact-utf8-identifier"
          },
          {
            "source": "intentDigest",
            "target": "operation_digest",
            "rule": "exact-sha256-digest"
          },
          {
            "source": "claimToken",
            "target": "claim_token",
            "rule": "do-not-copy; retain-source-provenance-and-derive-target"
          },
          {
            "source": "runId,attempt,moduleGenerationId",
            "target": "authority",
            "rule": "bind-by-explicit-generation-pair; no-type-coercion"
          }
        ],
        "claim_token_rule": "sha256(JCS({schema,instance_id,module_id,operation_id,operation_digest,controller_generation,extension_generation,worker_epoch,package_digest,policy_premise_digest,effect_class}))"
      },
      "authority_mapping": {
        "required_fields": [
          "daemon_installation_id",
          "instance_id",
          "controller_generation",
          "process.extension_generation",
          "process.worker_epoch",
          "process.binding_digest",
          "process.session_id",
          "process.process_id",
          "package_digest",
          "policy_premise_digest"
        ],
        "provenance_fields": [
          "package_digest",
          "executable_digest",
          "transport_digest",
          "process.binding_digest",
          "process.session_id",
          "process.process_id"
        ],
        "missing_disposition": "refuse-before-child-io"
      },
      "outcome_mapping": [
        {
          "source_kind": "intended",
          "source_evidence_rule": "source.outcome.kind=intended",
          "target_state": "INTENDED",
          "journal_revision": 1,
          "evidence_rule": "null",
          "per_intent_evidence": "required",
          "redispatch": "forbidden"
        },
        {
          "source_kind": "no-effect",
          "source_evidence_rule": "source.outcome.kind=no-effect",
          "target_state": "NOT_APPLIED",
          "journal_revision": 2,
          "evidence_rule": "sha256(JCS(no-effect-proof))",
          "per_intent_evidence": "required",
          "redispatch": "forbidden"
        },
        {
          "source_kind": "terminal",
          "source_evidence_rule": "source.outcome.kind=terminal;require-resultDigest",
          "target_state": "APPLIED",
          "journal_revision": 2,
          "evidence_rule": "source.outcome.resultDigest",
          "per_intent_evidence": "required",
          "redispatch": "forbidden"
        },
        {
          "source_kind": "unknown",
          "source_evidence_rule": "source.outcome.kind=unknown;retain-reason",
          "target_state": "UNKNOWN_OUTCOME",
          "journal_revision": 2,
          "evidence_rule": "null",
          "per_intent_evidence": "required",
          "redispatch": "forbidden"
        }
      ],
      "aggregate_evidence": "never-map-evidenceForRun-directly-to-one-Rust-record; require-each-intent-outcome",
      "canonicalization": {
        "scheme": "RFC8785-JCS",
        "encoding": "UTF-8",
        "digest": "sha256:<lowercase-hex>",
        "semantic_depth": 64,
        "wire_depth": 96,
        "unknown_fields": "reject"
      },
      "transport": {
        "extension_rpc": {
          "dialect": "dolly-extension-rpc/3.0",
          "framing": "four-byte-length-prefix",
          "length_endian": "big",
          "max_payload_bytes": 262144,
          "wire_depth": 96,
          "semantic_depth": 64
        },
        "mcp_stdio": {
          "dialect": "mcp/2025-06-18",
          "framing": "newline-delimited-json",
          "delimiter": "LF",
          "max_line_bytes": 262144,
          "wire_depth": 96,
          "semantic_depth": 64
        },
        "semantic_errors": [
          {
            "code": "EXTENSION_INVALID_PARAMS",
            "source_codes": [
              "FRAME_JSON_INVALID",
              "FRAME_LENGTH_INVALID",
              "FRAME_UTF8_INVALID",
              "FRAME_TOO_DEEP"
            ],
            "phase": "pre-effect",
            "outcome": "not_applied",
            "connection": "reusable",
            "redispatch": "forbidden"
          },
          {
            "code": "EXTENSION_INVALID_RESPONSE",
            "source_codes": [
              "FRAME_JSON_INVALID",
              "FRAME_LENGTH_INVALID",
              "FRAME_UTF8_INVALID",
              "FRAME_TOO_DEEP",
              "FRAME_TRANSPORT_FAILED"
            ],
            "phase": "post-write",
            "outcome": "unknown",
            "connection": "closed",
            "redispatch": "forbidden"
          },
          {
            "code": "MCP_REQUEST_INVALID",
            "source_codes": [
              "InvalidFrame",
              "RequestMismatch",
              "NotInitialized"
            ],
            "phase": "pre-effect",
            "outcome": "not_applied",
            "connection": "closed",
            "redispatch": "forbidden"
          },
          {
            "code": "MCP_RESPONSE_INVALID",
            "source_codes": [
              "InvalidFrame"
            ],
            "phase": "post-write",
            "outcome": "unknown",
            "connection": "closed",
            "redispatch": "forbidden"
          },
          {
            "code": "MCP_DISCONNECTED",
            "source_codes": [
              "Disconnected",
              "Io"
            ],
            "phase": "post-write",
            "outcome": "unknown",
            "connection": "closed",
            "redispatch": "forbidden"
          },
          {
            "code": "CLAIM_INTENT_PERSISTENCE_FAILED",
            "source_codes": [
              "EFFECT_INTENT_IO_FAILED",
              "EFFECT_INTENT_CONFLICT"
            ],
            "phase": "pre-effect",
            "outcome": "not_applied",
            "connection": "closed",
            "redispatch": "forbidden"
          }
        ]
      },
      "ordering": {
        "before_child_io": [
          "platform_gate",
          "authority_gate",
          "package_and_provenance_gate",
          "claim_intent_commit",
          "identity_pair_check"
        ],
        "first_external_write": "after-claim-intent-commit",
        "replay": "refuse-without-new-claim"
      },
      "identity_checks": [
        {
          "left": "authority.daemon_installation_id",
          "right": "installation.daemon_installation_id",
          "mismatch": "refuse"
        },
        {
          "left": "authority.instance_id",
          "right": "claim.instance_id",
          "mismatch": "refuse"
        },
        {
          "left": "authority.controller_generation",
          "right": "process.controller_generation",
          "mismatch": "refuse"
        },
        {
          "left": "authority.process.extension_generation",
          "right": "journal.extension_generation",
          "mismatch": "refuse"
        },
        {
          "left": "authority.process.worker_epoch",
          "right": "journal.worker_epoch",
          "mismatch": "refuse"
        },
        {
          "left": "authority.process.binding_digest",
          "right": "runtime.binding_digest",
          "mismatch": "refuse"
        }
      ]
    },
