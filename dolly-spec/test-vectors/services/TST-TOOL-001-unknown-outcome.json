      {"path": "/result/status", "op": "equals", "value": "unknown"},
      {"path": "/result/error/code", "op": "equals", "value": "TOOL_EXTERNAL_OUTCOME_UNKNOWN"},
      {"path": "/result/error/outcome", "op": "equals", "value": "unknown"}
