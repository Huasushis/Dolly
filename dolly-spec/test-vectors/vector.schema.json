{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolly.example/spec/0.1/test-vectors/vector.schema.json",
  "title": "Dolly conformance vector",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "test_id", "kind", "covers", "initial", "stimulus", "expected"],
  "properties": {
    "schema": {"const": "dolly.test-vector/v1"},
    "test_id": {"type": "string", "pattern": "^TST-[A-Z]+-[0-9]{3}$"},
    "kind": {"enum": ["core_transition", "crash_recovery", "protocol", "security", "service", "extension", "config", "research"]},
    "covers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(REQ|INV)-[A-Z0-9]+-[0-9]{3}$"}},
    "initial": true,
    "stimulus": true,
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "assertions", "emitted"],
      "properties": {
        "outcome": {"type": "string", "minLength": 1, "maxLength": 128},
        "assertions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "op"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "op": {"enum": ["equals", "not_equals", "absent", "unchanged", "contains", "count"]},
              "value": true
            },
            "if": {
              "properties": {"op": {"enum": ["absent", "unchanged"]}},
              "required": ["op"]
            },
            "then": {"not": {"required": ["value"]}},
            "else": {"required": ["value"]}
          }
        },
        "emitted": {"type": "array", "items": true},
        "crash_label": {"type": ["string", "null"], "maxLength": 128}
      }
    }
  }
}
