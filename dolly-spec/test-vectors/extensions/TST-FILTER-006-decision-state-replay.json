{
  "schema": "dolly.test-vector/v1",
  "test_id": "TST-FILTER-006",
  "kind": "extension",
  "covers": ["REQ-FILTER-001", "REQ-FILTER-002"],
  "initial": {
    "before_state": {
      "algorithm_revision": "two-thirds-mean-filter-v1",
      "internal_scale": 1000000,
      "bias_correction": true,
      "sources": []
    },
    "ordered_observations": [
      {"manifest_ordinal": 0, "source": "expert-a", "score": 200, "projection_eligible": true},
      {"manifest_ordinal": 1, "source": "expert-b", "score": 400, "projection_eligible": true},
      {"manifest_ordinal": 2, "source": "expert-c", "score": 750, "projection_eligible": true}
    ],
    "new_sample_weight_ppm": 1000000,
    "bias_correction": true,
    "forgeries": [
      {
        "kind": "derived_accumulator",
        "source": "expert-a",
        "claimed_accumulator": 300000000,
        "claimed_weight": 1000000,
        "claimed_corrected_score_q": 300000000,
        "recomputed_after_state_digest": true,
        "recomputed_candidate_distances": true,
        "recomputed_output_digest": true
      },
      {
        "kind": "committed_before_state",
        "recomputed_before_state_digest": true,
        "decision_locally_consistent": true
      },
      {
        "kind": "trusted_observation_score",
        "trusted_score": 200,
        "claimed_score": 300,
        "all_derived_fields_recomputed": true
      },
      {
        "kind": "manifest_context_substitution",
        "decision_manifest_digest_changed": true
      }
    ]
  },
  "stimulus": {
    "command": "validate_prepared_decision_by_replaying_ordered_observations_from_before_state"
  },
  "expected": {
    "outcome": "internally_self_consistent_forged_candidate_and_after_state_are_rejected",
    "assertions": [
      {"path": "/accepted_forgery_count", "op": "equals", "value": 0},
      {"path": "/derived_after_state/expert-a/accumulator", "op": "equals", "value": 200000000},
      {"path": "/claimed_after_state/expert-a/accumulator", "op": "equals", "value": 300000000},
      {"path": "/error", "op": "equals", "value": "FILTER_ORDERED_STATE_REPLAY_MISMATCH"}
    ],
    "emitted": [],
    "crash_label": null
  }
}
