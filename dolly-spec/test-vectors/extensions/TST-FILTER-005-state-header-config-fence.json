{
  "schema": "dolly.test-vector/v1",
  "test_id": "TST-FILTER-005",
  "kind": "extension",
  "covers": ["REQ-FILTER-001", "REQ-FILTER-002"],
  "initial": {
    "storage_scope_id": "0198ab31-6c44-7e8a-b2bb-000000000451",
    "channel": "default",
    "state_header": {
      "algorithm_revision": "two-thirds-mean-filter-v1",
      "internal_scale": 1000000,
      "bias_correction": true,
      "observation_count": 7
    }
  },
  "stimulus": {
    "commands": [
      {"operation": "prepare_config", "bias_correction": false, "state_epoch": "unchanged"},
      {"operation": "restart", "bias_correction": true},
      {"operation": "prepare_config", "bias_correction": false, "state_epoch": "fresh"}
    ]
  },
  "expected": {
    "outcome": "populated_state_cannot_be_reinterpreted_by_bias_toggle",
    "assertions": [
      {"path": "/commands/0/error", "op": "equals", "value": "FILTER_STATE_HEADER_CONFLICT"},
      {"path": "/commands/0/state_mutations", "op": "count", "value": 0},
      {"path": "/commands/1/state_header/bias_correction", "op": "equals", "value": true},
      {"path": "/commands/1/storage_scope_id", "op": "equals", "value": "0198ab31-6c44-7e8a-b2bb-000000000451"},
      {"path": "/commands/2/outcome", "op": "equals", "value": "fresh_state_epoch_prepared"},
      {"path": "/commands/2/inherited_observation_count", "op": "equals", "value": 0}
    ],
    "emitted": [],
    "crash_label": null
  }
}
