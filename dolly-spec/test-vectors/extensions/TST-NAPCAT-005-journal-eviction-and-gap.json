    "assertions": [
      {"path": "/commands/0/evicted_cursors", "op": "equals", "value": ["10"]},
      {"path": "/commands/0/oldest_available_cursor", "op": "equals", "value": "11"},
      {"path": "/commands/0/gap/reason", "op": "equals", "value": "retention"},
      {"path": "/commands/0/gap/from_cursor", "op": "equals", "value": "10"},
      {"path": "/commands/0/gap/to_cursor", "op": "equals", "value": "10"},
      {"path": "/consumers/agent-b/ack_cursor", "op": "equals", "value": "10"},
      {"path": "/commands/1/result/gaps/0/reason", "op": "equals", "value": "retention"},
      {"path": "/commands/2/marker/reason", "op": "equals", "value": "oversized_event"},
      {"path": "/commands/2/marker/raw_payload", "op": "absent"},
      {"path": "/commands/3/transport_state", "op": "equals", "value": "disconnected"},
      {"path": "/commands/3/hints_submitted", "op": "count", "value": 0},
      {"path": "/recovery/gap/reason", "op": "equals", "value": "disk_full"}
