    "oldest_available_cursor": "10",
    "consumers": {
      "agent-a": {"read_cursor": "12", "ack_cursor": "12"},
      "agent-b": {"read_cursor": "10", "ack_cursor": "10"}
    }
  },
  "stimulus": {
    "commands": [
      {"command": "append", "cursor": "13", "bytes": 1000},
      {"command": "read", "consumer": "agent-b", "after_cursor": "10"},
      {"command": "append_oversized", "cursor": "14", "bytes": 2000, "payload_digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333"},
      {"command": "append_with_disk_full", "cursor": "15", "bytes": 100}
    ]
  },
  "expected": {
